# Copy to .env.local after creating the Supabase project.
# Use only the project URL and publishable/anon key in the browser app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase Edge Function secrets only. Never prefix these with VITE_.
# Install secrets with `npx supabase secrets set ...`; do not commit real values.
AI_API_KEY=AQ.Ab8RN6KAhjmyNcMqKCNDqsPnsgZegBan7VhnEjx16A8qdLZdZA
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=
AI_PROVIDER=openai-compatible
# Required only when storing/updating an API key from the admin panel.
# Use a random secret with at least 32 characters.
AI_CONFIG_ENCRYPTION_KEY=
# Add a provider's hostname here before configuring a custom endpoint in Admin.
AI_ALLOWED_API_HOSTS=openai.com,openrouter.ai,groq.com,together.xyz,anthropic.com
